{
  "name": "arcane-tab-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute arcane-tab-db --file=src/db/schema.sql",
    "db:init:local": "wrangler d1 execute arcane-tab-db --file=src/db/schema.sql --local",
    "seed": "tsx scripts/seed.ts",
    "seed:local": "tsx scripts/seed.ts --local"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.14.0"
  }
}
